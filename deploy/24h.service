# /etc/systemd/system/24h.service
# Phase 1 only — not needed while the app is static.

[Unit]
Description=24h — resolve within a day
After=network.target

[Service]
Type=simple
User=app24h
WorkingDirectory=/srv/24h/server
EnvironmentFile=/srv/24h/server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/24h/data

[Install]
WantedBy=multi-user.target
